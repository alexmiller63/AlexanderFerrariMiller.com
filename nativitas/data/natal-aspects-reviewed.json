    "natal-aspect:mars:saturn:conjunction": {
      "id": "natal-aspect:mars:saturn:conjunction",
      "text": "Energy and restraint can meet with considerable force, making effort demanding rather than easily sustained. Activity may be uneven, with pressure building when determination meets a limit. The conjunction is treated as especially difficult, but its expression depends on the surrounding chart. Neither inevitable harm nor a fixed kind of character should be inferred from this contact alone.",
      "group": "mars-saturn-conjunction",
      "status": "passage-checked-transcription-edition-pending",
      "sources": [
        {
          "title": "C. E. O. Carter, The Astrological Aspects",
          "url": "https://pdfcoffee.com/the-astrological-aspects-by-charles-carter-pdf-free.html",
          "scope": "Conjunction: The Conjunction; General Observations; Sextile; trine: The Harmonious Aspects; Square; opposition: The Inharmonious Aspects",
          "qualification": "Passage-checked against transcription; edition and printed pagination verification pending."
        }
      ]
    },
