    "natal-aspect:mars:uranus:conjunction": {
      "id": "natal-aspect:mars:uranus:conjunction",
      "text": "Strong will and courage may be accompanied by dogged persistence, particularly when an immediate challenge demands action. Patience under prolonged pressure can be less secure, and determination may become excessive strain. The conjunction describes force and intensity rather than a uniformly easy advantage. Its direction and practical usefulness depend on the wider pattern of the chart.",
      "group": "mars-uranus-conjunction",
      "status": "passage-checked-transcription-edition-pending",
      "sources": [
        {
          "title": "C. E. O. Carter, The Astrological Aspects",
          "url": "https://pdfcoffee.com/the-astrological-aspects-by-charles-carter-pdf-free.html",
          "scope": "Conjunction: The Conjunction; Sextile; trine: The Harmonious Aspects; Square; opposition: The Inharmonious Aspects",
          "qualification": "Passage-checked against transcription; edition and printed pagination verification pending."
        }
