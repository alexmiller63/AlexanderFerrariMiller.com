    "natal-aspect:sun:mars:conjunction": {
      "id": "natal-aspect:sun:mars:conjunction",
      "text": "Purpose and active effort combine strongly, with a pronounced capacity for hard work and persistence. This resembles the constructive Sun–Mars contacts, but the intensity can also carry effort too far, making overwork a central caution. The surrounding aspects matter: the conjunction should not be treated as uniformly beneficial merely because it supplies energy.",
      "group": "sun-mars-conjunction",
      "status": "passage-checked-transcription-edition-pending",
      "sources": [
        {
          "title": "C. E. O. Carter, The Astrological Aspects",
