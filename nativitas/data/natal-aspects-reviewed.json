    "natal-aspect:venus:saturn:conjunction": {
      "id": "natal-aspect:venus:saturn:conjunction",
      "text": "Affection can become inseparable from obligation, with loyalty expressed through responsibility rather than ease or spontaneous pleasure. A serious ideal may command considerable personal sacrifice. The conjunction intensifies both the devotion and the restriction associated with this pair. It should not be presented as an easy promise of lasting happiness merely because commitment is strong.",
      "group": "venus-saturn-conjunction",
      "status": "passage-checked-transcription-edition-pending",
      "sources": [
        {
