    "natal-aspect:mars:jupiter:sextile": {
      "id": "natal-aspect:mars:jupiter:sextile",
      "text": "Enthusiasm can translate beliefs and interests into active effort. Travel, public causes, sport or the communication of ideas may offer suitable expression, with loyalty and a capacity for wholehearted participation. The traditional description is energetic rather than merely fortunate. Enjoyment and opportunity may accompany it, but neither wealth nor success follows independently of the wider chart.",
      "group": "mars-jupiter-sextile",
