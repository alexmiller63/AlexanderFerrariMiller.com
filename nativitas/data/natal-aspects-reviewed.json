    "natal-aspect:moon:saturn:conjunction": {
      "id": "natal-aspect:moon:saturn:conjunction",
      "text": "A serious, hardworking temperament may place duty and practical competence ahead of pleasure. Standards can be exacting, with criticism arising from a strong demand for things to be done properly. Confidence may be firm within familiar work but less adaptable elsewhere. The combination can support sustained responsibility, while narrowing interests or making enjoyment difficult.",
      "group": "moon-saturn-conjunction",
      "status": "passage-checked-transcription-edition-pending",
      "sources": [
        {
          "title": "C. E. O. Carter, The Astrological Aspects",
          "url": "https://pdfcoffee.com/the-astrological-aspects-by-charles-carter-pdf-free.html",
          "scope": "Conjunction: The Conjunction; Sextile; trine: The Harmonious Aspects; Square; opposition: The Inharmonious Aspects",
          "qualification": "Passage-checked against transcription; edition and printed pagination verification pending."
        }
      ]
    },
    "natal-aspect:moon:saturn:sextile": {
      "id": "natal-aspect:moon:saturn:sextile",
      "text": "Steadiness and a sense of responsibility can support careful management, dependable work and respect for established obligations. Feelings tend to be contained rather than freely displayed, with dignity sometimes becoming rigidity. The emphasis is on maintaining and using what has been entrusted to you. Practical reliability is more central here than originality or spontaneous enjoyment.",
      "group": "moon-saturn-sextile",
      "status": "passage-checked-transcription-edition-pending",
      "sources": [
        {
          "title": "C. E. O. Carter, The Astrological Aspects",
          "url": "https://pdfcoffee.com/the-astrological-aspects-by-charles-carter-pdf-free.html",
          "scope": "Conjunction: The Conjunction; Sextile; trine: The Harmonious Aspects; Square; opposition: The Inharmonious Aspects",
          "qualification": "Passage-checked against transcription; edition and printed pagination verification pending."
        }
      ]
    },
