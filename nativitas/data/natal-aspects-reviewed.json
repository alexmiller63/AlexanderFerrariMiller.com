    "natal-aspect:jupiter:saturn:conjunction": {
      "id": "natal-aspect:jupiter:saturn:conjunction",
      "text": "A demanding purpose may be pursued with exceptional patience and a willingness to work through difficulty. The combination can support substantial achievement, but its possibilities are tied to effort rather than ease. A serious outlook may become overly restrictive. This is a shared slow-planet influence whose personal importance depends on its connections with the rest of the chart.",
      "group": "jupiter-saturn-conjunction",
      "status": "passage-checked-transcription-edition-pending",
      "sources": [
        {
          "title": "C. E. O. Carter, The Astrological Aspects",
