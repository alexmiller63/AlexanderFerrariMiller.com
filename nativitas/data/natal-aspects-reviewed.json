    "natal-aspect:sun:jupiter:conjunction": {
      "id": "natal-aspect:sun:jupiter:conjunction",
      "text": "Benevolence and intellectual interests are joined by a more active, ambitious expression than in the quieter harmonious contacts. The traditional account associates this combination with literary, philosophical, religious or scientific pursuits, while allowing a relatively simple way of living. Its greater vigour should not be converted into an unconditional promise of wealth, position or success.",
      "group": "sun-jupiter-conjunction",
      "status": "passage-checked-transcription-edition-pending",
      "sources": [
        {
          "title": "C. E. O. Carter, The Astrological Aspects",
