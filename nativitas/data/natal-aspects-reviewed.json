    "natal-aspect:sun:venus:conjunction": {
      "id": "natal-aspect:sun:venus:conjunction",
      "text": "Affection, enjoyment and an appreciation of beauty colour the expression of the personality. The traditional description emphasizes warmth, cheerfulness and an attraction to artistic or refined surroundings. These qualities do not necessarily imply weakness, but neither do they guarantee vigorous worldly ambition. Their practical expression depends on the other elements of the chart.",
      "group": "sun-venus-conjunction",
      "status": "passage-checked-transcription-edition-pending",
      "sources": [
        {
          "title": "C. E. O. Carter, The Astrological Aspects",
