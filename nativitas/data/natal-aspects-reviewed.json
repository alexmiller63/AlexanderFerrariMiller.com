    "natal-aspect:mars:uranus:square": {
      "id": "natal-aspect:mars:uranus:square",
      "text": "A strong demand for freedom can make restrictions, delays or ordinary compromises difficult to tolerate. Energy may be abundant but unevenly directed, with abruptness or impatience interfering with the use of real ability. The account does not require an unkind nature. Its emphasis is on restless self-will and difficulty maintaining a workable relationship with limiting circumstances.",
      "group": "mars-uranus-square",
