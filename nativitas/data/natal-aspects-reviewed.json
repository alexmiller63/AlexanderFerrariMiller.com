    "natal-aspect:sun:uranus:conjunction": {
      "id": "natal-aspect:sun:uranus:conjunction",
      "text": "A strong desire to follow an independent course can accompany originality, talent and an attraction to unconventional pursuits. The traditional account particularly allows scientific or literary interests, while also acknowledging stubbornness and resistance to established occupations. The conjunction is not presented as necessarily disastrous; its more constructive or disruptive expression depends on the surrounding chart.",
      "group": "sun-uranus-conjunction",
      "status": "passage-checked-transcription-edition-pending",
      "sources": [
        {
          "title": "C. E. O. Carter, The Astrological Aspects",
