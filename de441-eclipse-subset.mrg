; Star Almanack — DE441 eclipse-catalog subset

;

; Purpose:

; Extract only the JPL DE441 ephemeris material needed for

; Star Almanack solar-eclipse calculations over the broad

; historical/future interval 2000 B.C. through A.D. 3000.

;

; This is a lossless SPK subset operation. It does NOT refit,

; approximate, or otherwise alter the JPL ephemeris.

;

; Bodies:

;   3   Earth-Moon barycenter

;   10  Sun

;   301 Moon

;   399 Earth

;

; Times are explicitly TDB so this operation does not depend on

; historical or predicted UTC / Delta-T assumptions.

LEAPSECONDS_KERNEL = naif0012.tls

SPK_KERNEL = de441-star-almanack-eclipses.bsp

  LOG_FILE = de441-star-almanack-eclipses.log

  BODIES = 3, 10, 301, 399

  SOURCE_SPK_KERNEL = de441_part-1.bsp

    BEGIN_TIME = 1 JAN 2000 B.C. 00:00:00 TDB

    END_TIME   = 31 DEC 3000 A.D. 23:59:59 TDB

  SOURCE_SPK_KERNEL = de441_part-2.bsp

    BEGIN_TIME = 1 JAN 2000 B.C. 00:00:00 TDB

    END_TIME   = 31 DEC 3000 A.D. 23:59:59 TDB

